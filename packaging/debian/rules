#!/usr/bin/make -f

export CARGO_TARGET_DIR = $(CURDIR)/target/debian
export DH_VERBOSE = 1
include /usr/share/dpkg/pkg-info.mk

%:
	dh $@

override_dh_auto_configure:
	rustup run 1.98.1 rustc --version

override_dh_auto_build:
	cargo +1.98.1 build --release --locked --bins
	cargo +1.98.1 build --release --locked --bins --manifest-path examples/plugins/Cargo.toml
	cargo +1.98.1 build --release --locked --bins --manifest-path tools/among-tools/Cargo.toml

override_dh_auto_test:
	cargo +1.98.1 test --locked
	cargo +1.98.1 test --locked --manifest-path examples/plugins/Cargo.toml
	cargo +1.98.1 test --locked --manifest-path tools/among-tools/Cargo.toml

override_dh_auto_install:
	$(CARGO_TARGET_DIR)/release/among-tools stage-deb $(CURDIR) $(CARGO_TARGET_DIR)/release debian/tmp
	$(CARGO_TARGET_DIR)/release/among-tools package-metainfo data/com.github.among-terminal.metainfo.xml "$(DEB_VERSION_UPSTREAM)" debian/tmp/usr/share/metainfo/com.github.among-terminal.metainfo.xml

override_dh_auto_clean:
	cargo +1.98.1 clean --target-dir $(CARGO_TARGET_DIR)

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_compress:
	dh_compress -XLICENSE -XNOTICE -XTHIRD_PARTY
