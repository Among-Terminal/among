FROM ubuntu@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55

# separate synthetic desktop; never mount the owner's display or D-Bus sockets.
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb xserver-xephyr x11-xserver-utils openbox gnome-shell dbus-x11 xdotool x11-utils imagemagick ffmpeg \
    ca-certificates gcc libc6-dev pkg-config desktop-file-utils appstream libgtk-4-bin librsvg2-common \
    libgtk-4-dev libadwaita-1-dev libvte-2.91-gtk4-dev \
    && rm -rf /var/lib/apt/lists/*

# keep runner-only prerequisites separate from the reusable graphical layer.
RUN apt-get update && apt-get install -y --no-install-recommends git squashfs-tools jq \
    && rm -rf /var/lib/apt/lists/*

# GitHub-hosted runners use uid 1001 for the job user. The media scene starts
# its own session bus, and dbus-daemon refuses to start for a uid without a
# passwd entry, so give that uid a name inside the disposable image.
RUN groupadd --gid 1001 runner \
    && useradd --uid 1001 --gid 1001 --no-create-home --shell /usr/sbin/nologin runner

# The documentation media scene lives at a path that can appear in a
# notification without exposing the private owned HOME. Any runtime uid may
# create its own project below /work; the sticky bit keeps the directory
# shared without letting one run remove another run's entries.
RUN install -d -m 1777 /work
