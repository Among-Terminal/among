FROM ubuntu@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
# gnupg signs the throwaway local repository the APT collection test serves
# offline; nothing in the image trusts that key outside the test.
RUN apt-get update && apt-get install -y --no-install-recommends debhelper desktop-file-utils gnupg && rm -rf /var/lib/apt/lists/*
