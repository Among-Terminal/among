--- a/ext/pulse/pulsesink.c
+++ b/ext/pulse/pulsesink.c
@@ -334,6 +334,51 @@
   pbuf->stream_name = NULL;
 }
 
+static void
+gst_pulse_context_drain_cb (pa_context * context, void *userdata)
+{
+  (void) context;
+  (void) userdata;
+  GST_INFO ("Final-context pending-dispatch drain callback reached");
+  pa_threaded_mainloop_signal (mainloop, 0);
+}
+
+/* Under the caller's existing mainloop lock, drain outbound data and pending
+ * command replies before disconnecting the final context. This tests command
+ * ordering, NOT completion of sink IO-thread or imported-memblock cleanup.
+ */
+static void
+gst_pulse_drain_final_context (GstPulseRingBuffer * pbuf, pa_context * context)
+{
+  pa_operation *operation;
+
+  if (pa_context_get_state (context) != PA_CONTEXT_READY) {
+    GST_INFO_OBJECT (pbuf, "Final-context drain skipped: context not READY");
+    return;
+  }
+  if (pa_threaded_mainloop_in_thread (mainloop)) {
+    GST_INFO_OBJECT (pbuf, "Final-context drain skipped: mainloop thread");
+    return;
+  }
+  if (pa_context_is_pending (context) <= 0) {
+    GST_INFO_OBJECT (pbuf, "Final-context drain skipped: no pending dispatch");
+    return;
+  }
+
+  GST_INFO_OBJECT (pbuf, "Final-context pending-dispatch drain requested");
+  operation = pa_context_drain (context, gst_pulse_context_drain_cb, NULL);
+  if (!operation) {
+    GST_WARNING_OBJECT (pbuf, "Final-context drain operation unavailable");
+    return;
+  }
+  while (pa_operation_get_state (operation) == PA_OPERATION_RUNNING &&
+      pa_context_get_state (context) == PA_CONTEXT_READY)
+    pa_threaded_mainloop_wait (mainloop);
+  GST_INFO_OBJECT (pbuf, "Final-context drain finished with state %d", pa_operation_get_state (operation));
+  pa_operation_cancel (operation);
+  pa_operation_unref (operation);
+}
+
 static void
 gst_pulsering_destroy_context (GstPulseRingBuffer * pbuf)
 {
@@ -362,6 +407,13 @@
             "destroying final context with name %s, pbuf=%p, pctx=%p",
             pbuf->context_name, pbuf, pctx);
 
+        /* The table owns no value destructor. Detach this last-user context
+         * before releasing the shared lock, so a concurrent opener cannot
+         * reuse it or block the mainloop while waiting for that same lock. */
+        g_hash_table_remove (gst_pulse_shared_contexts, pbuf->context_name);
+        g_mutex_unlock (&pa_shared_resource_mutex);
+        gst_pulse_drain_final_context (pbuf, pctx->context);
+
         pa_context_disconnect (pctx->context);
 
         /* Make sure we don't get any further callbacks */
@@ -371,10 +423,10 @@
         pa_context_set_state_callback (pctx->context, NULL, NULL);
         pa_context_set_subscribe_callback (pctx->context, NULL, NULL);
 
-        g_hash_table_remove (gst_pulse_shared_contexts, pbuf->context_name);
-
         pa_context_unref (pctx->context);
         g_free (pctx);
+        /* Restore the caller's lock invariant; never remove a newer entry. */
+        g_mutex_lock (&pa_shared_resource_mutex);
       }
     }
     g_free (pbuf->context_name);
